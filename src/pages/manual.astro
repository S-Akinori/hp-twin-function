---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  basicSteps,
  manualAssets,
  manualToc,
  safetyCards,
  simSteps,
  simWarnings,
  troubleshootingCards,
  wifiHints,
  wifiSteps,
} from "../data/manual";
import ButtonLink from "../components/ui/ButtonLink.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
---

<BaseLayout title="Twin Function - 取扱説明書" description="Twin Functionの取扱説明書。乾電池のセット、SIMカード設定、Wi-Fi接続、充電方法、注意事項をご案内します。">
  <main id="top">
      <PageHero
        eyebrow="Manual"
        title="Twin Function 取扱説明書"
        description="基本的な使い方からSIMカード、Wi-Fi接続、トラブルシューティングまで、安全にご利用いただくための情報をまとめました。"
        image={manualAssets.hero}
        imageAlt="Twin Function と乾電池3本"
      />

      <section class="border-y border-white/10 bg-ink-900/70">
        <nav class="mx-auto grid max-w-[1680px] gap-3 px-5 py-5 sm:grid-cols-2 sm:px-8 lg:grid-cols-5 lg:px-16" aria-label="取扱説明書目次">
          {manualToc.map((item) => (
            <a class="rounded-full border border-white/10 px-5 py-3 text-center text-sm font-semibold text-white/74 transition hover:border-gold-400 hover:text-gold-400" href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>
      </section>

      <section id="basic" class="manual-page-section bg-ink-950">
        <SectionHeading eyebrow="Basic Usage" title="基本的な使い方" />
        <div class="mt-12 grid gap-6">
          {basicSteps.map((step) => (
            <article class="manual-step-row">
              <div class="manual-step-label">{step.label}</div>
              <div class="manual-step-content">
                <img class="h-14 w-14 object-contain" src={step.icon} alt="" />
                <div>
                  <div class="flex items-center gap-4">
                    <span class="manual-number">{step.no}</span>
                    <h3>{step.title}</h3>
                  </div>
                  <p>{step.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="sim" class="manual-page-section bg-[linear-gradient(180deg,#07111f,#08182b)]">
        <SectionHeading
          eyebrow="SIM Setup"
          title="SIMカードのセットアップ方法"
          description="Twin FunctionでWi-Fi接続を利用するには、データ通信対応のSIMカードが必要です。"
        />
        <div class="mt-12 grid gap-6">
          {simSteps.map((step) => (
            <article class="manual-step-row">
              <div class="manual-step-label">{step.label}</div>
              <div class="manual-step-content">
                <img class="h-14 w-14 object-contain" src="/assets/icons/08_wifi.png" alt="" />
                <div>
                  <div class="flex items-center gap-4">
                    <span class="manual-number">{step.no}</span>
                    <h3>{step.title}</h3>
                  </div>
                  <p>{step.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <aside class="manual-note warning">
          <h3>注意事項</h3>
          <ul>
            {simWarnings.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </section>

      <section id="wifi" class="manual-page-section bg-white text-ink-950">
        <SectionHeading
          eyebrow="Wi-Fi Setup"
          title="Wi-Fi接続の詳細手順"
          description="スマートフォンからTwin FunctionのWi-Fiネットワークに接続する方法です。"
          theme="light"
        />
        <div class="manual-card-grid">
          {wifiSteps.map((step) => (
            <article class="manual-light-card">
              <div class="manual-card-head">
                <span>{step.no}</span>
                <h3>{step.title}</h3>
              </div>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
        <aside class="manual-note info light-note">
          <h3>ヒント</h3>
          <ul>
            {wifiHints.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </section>

      <section id="safety" class="manual-page-section bg-ink-950">
        <SectionHeading eyebrow="Safety" title="ご使用上の注意" />
        <div class="manual-card-grid">
          {safetyCards.map((card) => (
            <article class="manual-dark-card">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="trouble" class="manual-page-section bg-[linear-gradient(180deg,#07111f,#050b15)]">
        <SectionHeading eyebrow="Troubleshooting" title="トラブルシューティング" />
        <div class="manual-card-grid three">
          {troubleshootingCards.map((card) => (
            <article class="manual-dark-card">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="bg-white px-5 py-16 text-center text-ink-950 sm:px-8">
        <h2 class="text-3xl font-bold sm:text-5xl">製品詳細ページへ戻る</h2>
        <div class="mt-8 flex justify-center">
          <ButtonLink class="px-10 py-5 text-base" href="/">製品ページへ戻る</ButtonLink>
        </div>
      </section>
  </main>
</BaseLayout>
