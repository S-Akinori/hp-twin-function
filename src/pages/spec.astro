---
import BaseLayout from "../layouts/BaseLayout.astro";
import { assets, specDetails } from "../data/site";
import PageHero from "../components/ui/PageHero.astro";
import SpecTable from "../components/ui/SpecTable.astro";
---

<BaseLayout title="スペック | Twin Function" description="Twin Functionの製品仕様。対応電池、サイズ、重量、Wi-Fi機能などを掲載しています。">
  <main>
      <PageHero
        eyebrow="Spec"
        title="製品スペック"
        description="Twin Functionの基本仕様と利用シーンをまとめています。"
        image={assets.productWithBatteries}
        imageAlt="Twin Function と乾電池3本"
      />

      <section class="bg-white px-5 py-20 text-ink-950 sm:px-8 lg:px-16">
        <SpecTable items={specDetails} class="mx-auto max-w-[1120px]" />
      </section>
  </main>
</BaseLayout>
