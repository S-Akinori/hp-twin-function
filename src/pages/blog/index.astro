---
import { sanityClient } from "sanity:client";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { BLOG_POSTS_QUERY } from "../../sanity/queries";
import type { BlogPostSummary } from "../../sanity/types";

const posts = await sanityClient.fetch<BlogPostSummary[]>(BLOG_POSTS_QUERY);
const [featuredPost, ...remainingPosts] = posts;
---

<BaseLayout
  title="ブログ | Twin Function"
  description="充電、通信、防災、外出時の備えに役立つ情報をTwin Function編集部がお届けします。"
  enableScrollAnimation
>
  <main>
    <section class="relative overflow-hidden pb-20 pt-36 sm:pb-28 sm:pt-44">
      <div class="absolute inset-0 soft-grid opacity-60" aria-hidden="true"></div>
      <div class="absolute -right-44 top-4 h-[34rem] w-[34rem] rounded-full bg-blue-500/15 blur-[110px]" aria-hidden="true"></div>
      <div class="section-shell relative">
        <p class="eyebrow">Journal / Twin Function</p>
        <h1 class="mt-7 max-w-5xl text-5xl font-semibold leading-[1.05] tracking-[-0.035em] text-white sm:text-7xl lg:text-8xl">
          日常と、もしもの間にある<br class="hidden sm:block" />
          <span class="text-gold-400">知っておきたいこと。</span>
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-9 text-white/65 sm:text-xl">
          充電、通信、防災、外出時の備え。Twin Functionをもっと安心して使うための知識とアイデアを届けます。
        </p>
      </div>
    </section>

    <section class="section-shell pb-24 sm:pb-32">
      {
        featuredPost ? (
          <>
            <div class="mb-8 flex items-end justify-between border-b border-white/10 pb-5">
              <div>
                <p class="eyebrow">Latest story</p>
                <h2 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">最新の記事</h2>
              </div>
              <p class="text-sm text-white/45">{posts.length} ARTICLES</p>
            </div>
            <BlogCard post={featuredPost} featured />
            {remainingPosts.length > 0 && (
              <div class="mt-16 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                {remainingPosts.map((post) => <BlogCard post={post} />)}
              </div>
            )}
          </>
        ) : (
          <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.035] px-6 py-20 text-center sm:px-12">
            <p class="eyebrow">Coming soon</p>
            <h2 class="mt-5 text-3xl font-semibold text-white sm:text-5xl">最初の記事を準備しています。</h2>
            <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-white/60">
              Sanity Studioから記事を公開すると、このページに自動で表示されます。
            </p>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
