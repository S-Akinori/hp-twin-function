---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqItems } from "../data/site";
import PageHero from "../components/ui/PageHero.astro";
import FaqList from "../components/ui/FaqList.astro";
---

<BaseLayout title="FAQ | Twin Function" description="Twin Functionに関するよくある質問。乾電池、Wi-Fi、充電、保管方法について回答します。">
  <main>
      <PageHero
        eyebrow="FAQ"
        title="よくある質問"
        description="Twin Functionの仕様、使い方、保管方法について、よくある質問をまとめました。"
        compact
      />

      <section class="bg-[linear-gradient(180deg,#07111f,#050b15)] px-5 py-20 sm:px-8 lg:px-16">
        <FaqList items={faqItems} />
      </section>
  </main>
</BaseLayout>
