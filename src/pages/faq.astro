---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { faqItems } from "../data/site";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Twin Functionに関するよくある質問。乾電池、Wi-Fi、充電、保管方法について回答します。" />
    <title>FAQ | Twin Function</title>
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <Header />
    <main>
      <section class="relative overflow-hidden bg-ink-950 pt-20">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_10%,rgba(73,116,181,0.28),transparent_34rem)]" aria-hidden="true"></div>
        <div class="relative mx-auto min-h-[460px] max-w-[1680px] px-5 py-20 sm:px-8 lg:px-16">
          <p class="eyebrow text-2xl">FAQ</p>
          <div class="mt-6 h-1 w-20 bg-gold-400"></div>
          <h1 class="mt-9 text-5xl font-semibold leading-tight text-white sm:text-7xl">よくある質問</h1>
          <p class="mt-8 max-w-2xl text-xl leading-9 text-white/74">
            Twin Functionの仕様、使い方、保管方法について、よくある質問をまとめました。
          </p>
        </div>
      </section>

      <section class="bg-[linear-gradient(180deg,#07111f,#050b15)] px-5 py-20 sm:px-8 lg:px-16">
        <div class="mx-auto grid max-w-[1120px] gap-5">
          {faqItems.map((item) => (
            <details class="group rounded-lg border border-white/10 bg-white/[0.035] p-6 shadow-insetLine">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-xl font-bold text-white">
                {item.question}
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gold-400 text-ink-950 transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-5 text-lg leading-8 text-white/72">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
