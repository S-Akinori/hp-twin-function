---
import BaseLayout from "../layouts/BaseLayout.astro";
import { assets, featureCards, featurePageDetails, featurePagePoints, featureUseScenes } from "../data/site";
import PageHero from "../components/ui/PageHero.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import CtaSection from "../components/sections/CtaSection.astro";
---

<BaseLayout title="特徴 | Twin Function" description="Twin Functionの特徴。乾電池3本対応、Wi-Fi搭載、ケーブル不要の直接充電などをご紹介します。">
  <main>
      <PageHero
        eyebrow="Features"
        title="3つの安心"
        description="日常も、もしもの時も。Twin Functionは、つながる、充電できる、備えられる安心を小さな筐体にまとめました。"
        
        backgroundImage={assets.circuitGrid}
      />

      <section class="bg-[linear-gradient(180deg,#07111f,#050b15)] px-5 py-20 sm:px-8 lg:px-16">
        <div class="mx-auto grid max-w-[1320px] gap-7 lg:grid-cols-3">
          {featureCards.map((card) => (
            <FeatureCard no={card.no} title={card.title} text={card.text} icon={card.icon} align="center" />
          ))}
        </div>
      </section>

      <section class="relative overflow-hidden bg-ink-950 px-5 pb-28 pt-20 text-white sm:px-8 lg:px-16">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_12%,rgba(73,116,181,0.28),transparent_34rem)]" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-[1320px]">
          <SectionHeading
            eyebrow="Key Points"
            title="持ち運び、通信、非常時まで。選ばれる理由を具体化。"
          />

          <div class="mt-14 grid gap-8">
            {featurePagePoints.map((point) => (
              <article class="grid gap-6 border-b border-white/12 pb-8 md:grid-cols-[210px_1fr] md:items-center">
                <div class="flex h-32 w-32 flex-col items-center justify-center border-2 border-white/82 text-center md:h-40 md:w-40">
                  <span class="font-serif text-3xl italic leading-none text-white">Point</span>
                  <span class="mt-2 text-6xl font-semibold leading-none text-white">{point.no}</span>
                </div>
                <div>
                  <h2 class="text-3xl font-semibold leading-tight text-white sm:text-5xl">{point.title}</h2>
                  <p class="mt-5 max-w-4xl text-lg leading-9 text-white/72">{point.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="absolute bottom-0 left-0 h-24 w-full bg-white [clip-path:polygon(0_42%,50%_100%,100%_42%,100%_100%,0_100%)]" aria-hidden="true"></div>
      </section>

      <section class="bg-[linear-gradient(180deg,#ffffff,#f4f7fb)] px-5 py-20 text-ink-950 sm:px-8 lg:px-16">
        <div class="mx-auto grid max-w-[1320px] gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div>
            <SectionHeading
              eyebrow="Function Details"
              title="外出先で使える機能を、ひとつの本体に集約。"
              description="Wi-Fi、乾電池充電、直接接続、ケーブルレス、軽量設計。毎日の持ち物を増やさず、必要な機能をすぐ使える形にまとめています。"
              theme="light"
            />

            <div class="mt-12 grid gap-6">
              {featurePageDetails.map((detail) => (
                <div class="grid grid-cols-[72px_1fr] gap-5 rounded-lg border border-ink-950/10 bg-white p-5 shadow-[0_18px_60px_rgba(5,11,21,0.07)]">
                  <div class="grid h-16 w-16 place-items-center rounded-full bg-ink-950">
                    <img class="h-10 w-10 object-contain" src={detail.icon} alt="" />
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-gold-600">{detail.title}</h3>
                    <p class="mt-2 text-base leading-8 text-ink-950/72">{detail.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="relative overflow-hidden rounded-lg bg-ink-950">
            <img class="absolute inset-0 h-full w-full object-cover" src={assets.functionDetailsHero} alt="Twin FunctionのWi-Fi、乾電池3本、直接充電をまとめた利用イメージ" loading="lazy" />
            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,11,21,0.82),rgba(5,11,21,0.28)_48%,rgba(5,11,21,0.02))]" aria-hidden="true"></div>
            <div class="relative z-[1] max-w-sm p-8">
              <p class="eyebrow text-gold-400">Cableless Charge</p>
              <h3 class="mt-5 text-3xl font-semibold leading-tight text-white">ケーブルを探さず、スマホに直接。</h3>
              <p class="mt-5 text-lg leading-8 text-white">Type-CやLightningなど、端末に合わせた直接接続で、持ち物を減らしながら充電できます。</p>
            </div>
          </div>
        </div>
      </section>

      <section class="px-5 py-20 sm:px-8 lg:px-16">
        <div class="mx-auto max-w-[1320px]">
          <div class="">
            <SectionHeading
              eyebrow="Use Scenes"
              title="使う場所を選ばない、4つの利用シーン。"
              description="出張、カフェ作業、移動中の動画、オンライン会議。Twin Functionは、充電と通信が欲しい場面に自然に持ち込めます。"
            />
          </div>

          <div class="mt-14 grid gap-6 md:grid-cols-2">
            {featureUseScenes.map((scene) => (
              <article class="group overflow-hidden rounded-lg border border-white/10 bg-white/[0.045] shadow-[0_24px_80px_rgba(0,0,0,0.28)]">
                <div class="relative aspect-[16/10] overflow-hidden bg-ink-900">
                  <img class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" src={scene.image} alt={`${scene.title}でTwin Functionを使うイメージ`} loading="lazy" />
                  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,11,21,0.04),rgba(5,11,21,0.72))]" aria-hidden="true"></div>
                  <span class="absolute left-5 top-5 rounded-full border border-gold-400/50 bg-ink-950/72 px-4 py-2 text-xs font-bold uppercase tracking-[0.24em] text-gold-400 backdrop-blur-md">
                    Scene
                  </span>
                </div>
                <div class="p-6 sm:p-8">
                  <h3 class="text-3xl font-semibold text-white">{scene.title}</h3>
                  <div class="mt-5 h-0.5 w-12 bg-gold-400"></div>
                  <p class="mt-5 text-lg leading-8 text-white/72">{scene.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
       <CtaSection />
  </main>
</BaseLayout>
