---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import MessageSection from "../components/sections/MessageSection.astro";
import StorySection from "../components/sections/StorySection.astro";
import FeaturesSection from "../components/sections/FeaturesSection.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import ManualSection from "../components/sections/ManualSection.astro";
---

<BaseLayout
  title="Twin Function | Wi-Fi搭載の乾電池式モバイルバッテリー"
  description="Wi-Fi搭載の乾電池式モバイルバッテリー Twin Function の製品紹介サイト"
  enableScrollAnimation
>
  <main id="top">
    <HeroSection />
    <MessageSection />
    <StorySection />
    <FeaturesSection />
    <CtaSection />
    <ManualSection />
  </main>
</BaseLayout>
