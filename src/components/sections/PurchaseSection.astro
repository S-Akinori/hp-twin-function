---
import ProductBadge from "../ProductBadge.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import { assets, purchaseFeatures, purchasePlans, specs } from "../../data/site";
---

<section id="purchase" class="relative min-h-[900px] overflow-hidden bg-[radial-gradient(circle_at_18%_72%,rgba(73,116,181,0.38),transparent_34rem),#061121] py-20">
  <div class="mx-auto md:grid w-full max-w-[1680px] gap-12 px-5 sm:px-8 lg:min-h-[760px] lg:grid-cols-[1.15fr_0.85fr] lg:px-16">
    <div class="flex flex-col justify-between">
      <div>
        <p class="eyebrow text-2xl">BUY</p>
        <div class="mt-5 h-1 w-16 bg-gold-400"></div>
        <h2 class="mt-6 text-4xl font-semibold leading-none text-white sm:text-6xl">Twin Function</h2>
        <p class="mt-7 text-xl text-white sm:text-2xl">Wi-Fi搭載の乾電池式モバイルバッテリー</p>
        <ProductBadge class="mt-8 rounded-lg px-7 py-4 text-2xl" />
      </div>

      <img class="mt-10 w-full max-w-[900px]" src={assets.productWithBatteries} alt="Twin Function と乾電池3本" />

      <div id="spec" class="mt-8 mb-4 grid rounded-lg border border-white/[0.22] bg-ink-950/54 p-6 sm:grid-cols-4">
        {specs.map((spec) => (
          <div class="border-white/18 px-4 py-3 sm:border-r sm:last:border-r-0">
            <p class="text-lg font-semibold text-white">{spec.name}</p>
            <p class="mt-4 text-lg leading-7 text-white/80">{spec.value}</p>
          </div>
        ))}
      </div>
    </div>

    <aside class="self-center rounded-[1.4rem] border border-white/[0.24] bg-ink-950/58 p-8 shadow-insetLine backdrop-blur-md sm:p-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-2xl text-white">商品プラン</p>
        <span class="border border-white/30 px-4 py-2 text-sm text-white/82 sm:text-base">送料無料</span>
      </div>
      <div class="mt-7 grid gap-4">
        {purchasePlans.map((plan) => (
          <div class="rounded-xl border border-white/20 bg-white/[0.06] p-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-2xl font-semibold text-white sm:text-3xl">{plan.name}</p>
                <p class="mt-1 text-base text-white/64 sm:text-lg">{plan.description}</p>
              </div>
              <p class="shrink-0 pt-1 text-sm text-white/60 sm:text-base">税込価格</p>
            </div>
            <div class="mt-5 flex items-end justify-end gap-2 text-white">
              <span class="text-5xl font-semibold leading-none sm:text-6xl">{plan.price}</span>
              <span class="pb-1 text-2xl sm:text-3xl">円</span>
            </div>
            <ButtonLink class="mt-6 w-full gap-3 py-4 text-lg sm:text-xl" href={plan.purchaseUrl}>
              <img class="h-8 w-8 object-contain" src={assets.purchaseCartIcon} alt="" />
              {plan.purchaseLabel}
            </ButtonLink>
          </div>
        ))}
      </div>
      <div class="mt-8 grid grid-cols-3 gap-4 text-center text-white/82">
        {purchaseFeatures.map((item) => (
          <div>
            <img class="mx-auto h-12 w-12 object-contain" src={item.icon} alt="" />
            <p class="mt-3 text-base">{item.label}</p>
          </div>
        ))}
      </div>
    </aside>
  </div>
</section>
