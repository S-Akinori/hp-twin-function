---
import ProductBadge from "../ProductBadge.astro";
import { assets, purchaseFeatures, specs } from "../../data/site";
---

<section id="purchase" class="relative min-h-[900px] overflow-hidden bg-[radial-gradient(circle_at_18%_72%,rgba(73,116,181,0.38),transparent_34rem),#061121] py-20">
  <div class="mx-auto md:grid w-full max-w-[1680px] gap-12 px-5 sm:px-8 lg:min-h-[760px] lg:grid-cols-[1.15fr_0.85fr] lg:px-16">
    <div class="flex flex-col justify-between">
      <div>
        <p class="eyebrow text-2xl">BUY</p>
        <div class="mt-5 h-1 w-16 bg-gold-400"></div>
        <h2 class="mt-6 text-4xl font-semibold leading-none text-white sm:text-6xl">Twin Function</h2>
        <p class="mt-7 text-xl text-white sm:text-2xl">Wi-Fi搭載の乾電池式モバイルバッテリー</p>
        <ProductBadge class="mt-8 rounded-lg px-7 py-4 text-2xl" />
      </div>

      <img class="mt-10 w-full max-w-[900px]" src={assets.productWithBatteries} alt="Twin Function と乾電池3本" />

      <div id="spec" class="mt-8 mb-4 grid rounded-lg border border-white/[0.22] bg-ink-950/54 p-6 sm:grid-cols-4">
        {specs.map((spec) => (
          <div class="border-white/18 px-4 py-3 sm:border-r sm:last:border-r-0">
            <p class="text-lg font-semibold text-white">{spec.name}</p>
            <p class="mt-4 text-lg leading-7 text-white/80">{spec.value}</p>
          </div>
        ))}
      </div>
    </div>

    <aside class="self-center rounded-[1.4rem] border border-white/[0.24] bg-ink-950/58 p-8 shadow-insetLine backdrop-blur-md sm:p-12">
      <p class="text-2xl text-white/74">税込価格</p>
      <div class="mt-5 flex items-end gap-4 text-white">
        <span class="text-6xl font-semibold leading-none sm:text-[7.5rem]">38,000</span>
        <span class="pb-3 text-3xl sm:text-5xl">円</span>
        <span class="mb-4 border border-white/30 px-3 py-2 text-sm sm:px-5 sm:py-3 sm:text-xl">送料無料</span>
      </div>
      <div class="my-10 h-px bg-white/28"></div>
      <a class="yellow-button mt-10 w-full gap-5 py-7 text-3xl" href="https://www.makuake.com/project/twin-function/">
        <img class="h-10 w-10 object-contain invert" src={assets.cartIcon} alt="" />
        購入する
      </a>
      <div class="mt-8 grid grid-cols-3 gap-4 text-center text-white/82">
        {purchaseFeatures.map((item) => (
          <div>
            <img class="mx-auto h-12 w-12 object-contain" src={item.icon} alt="" />
            <p class="mt-3 text-base">{item.label}</p>
          </div>
        ))}
      </div>
    </aside>
  </div>
</section>
