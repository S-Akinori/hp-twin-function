---
import { assets, featureCards } from "../../data/site";
---

<section id="features" class="relative min-h-[900px] overflow-hidden bg-[radial-gradient(circle_at_center,rgba(62,103,164,0.34),transparent_31rem),#061121] py-20">
  <div class="mx-auto w-full max-w-[1680px] px-5 sm:px-8 lg:px-16">
    <div class="text-center">
      <p class="eyebrow text-2xl">FEATURES</p>
      <div class="mx-auto mt-5 h-0.5 w-16 bg-gold-400"></div>
      <h2 class="mt-3 text-6xl font-semibold leading-none text-white sm:text-7xl xl:text-[8.5rem]">3つの安心</h2>
      <p class="mt-5 text-xl font-semibold text-white/92">日常も、もしもの時も。これ1台で、つながる・充電できる・安心が続く。</p>
    </div>

    <div class="relative mt-16 grid min-h-[570px] gap-8 lg:grid-cols-[0.84fr_1.22fr_0.84fr]">
      <img class="relative mx-auto w-full max-w-[720px] drop-shadow-product lg:hidden" src={assets.product} alt="Twin Function 本体" />
      <article class="feature-card self-center px-8 py-10 text-center">
        <p class="text-4xl font-bold text-gold-400">{featureCards[0].no}</p>
        <div class="mx-auto grid h-32 w-32 place-items-center rounded-full border border-gold-400">
          <img class="h-20 w-20 object-contain" src={featureCards[0].icon} alt="" />
        </div>
        <h3 class="mt-10 text-4xl font-semibold text-white">{featureCards[0].title}</h3>
        <div class="mx-auto mt-6 h-0.5 w-12 bg-gold-400"></div>
        <p class="mx-auto mt-7 max-w-[330px] text-xl leading-9 text-white/82">{featureCards[0].text}</p>
      </article>

      <img class="relative mx-auto w-full max-w-[720px] drop-shadow-product hidden lg:block" src={assets.product} alt="Twin Function 本体" />
      <!-- <div class="relative flex min-h-[360px] flex-col items-stretch justify-end lg:min-h-0 lg:items-end lg:justify-center">
        <img class="relative mx-auto w-full max-w-[720px] drop-shadow-product lg:absolute lg:inset-x-0 lg:top-0" src={assets.product} alt="Twin Function 本体" />
        <div class="relative z-[1] mb-0 flex w-full max-w-[680px] flex-col items-center justify-center gap-4 rounded-lg border border-white/[0.22] bg-ink-950/72 px-5 py-5 text-center shadow-insetLine sm:flex-row sm:gap-9 sm:px-10 sm:py-8 lg:absolute lg:bottom-0">
          <img class="h-16 w-16 object-contain" src="/assets/icons/12_home_safety.png" alt="" />
          <p class="text-2xl font-semibold text-white sm:text-4xl">最大8台接続</p>
          <span class="hidden h-14 w-px bg-white/30 sm:block"></span>
          <p class="text-lg leading-7 text-white/80">スマホもPCもタブレットも、これ1台で同時に使える。</p>
        </div>
      </div> -->

      <div class="grid gap-7 self-center">
        {featureCards.slice(1).map((card) => (
          <article class="feature-card p-9 text-center">
            <p class="text-4xl font-bold text-gold-400">{card.no}</p>
            <div class="mx-auto grid h-32 w-32 place-items-center rounded-full border border-gold-400">
              <img class="h-20 w-20 object-contain" src={card.icon} alt="" />
            </div>
            <h3 class="mt-8 text-4xl font-semibold text-white">{card.title}</h3>
            <div class="mx-auto mt-6 h-0.5 w-12 bg-gold-400"></div>
            <p class="mt-7 text-lg leading-8 text-white/80">{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
