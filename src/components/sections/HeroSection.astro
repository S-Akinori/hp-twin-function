---
import ProductBadge from "../ProductBadge.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import { assets, heroFeatures } from "../../data/site";
---

<section class="hero-stage relative min-h-[100dvh] overflow-hidden pt-20 bg-[url('/assets/backgrounds/bg-digital.png')] bg-cover bg-center">
  <div class="relative mx-auto min-h-[calc(100dvh-5rem)] w-full max-w-[1680px] px-5 pb-10 pt-10 sm:px-8 lg:px-12">
    
    <div class="relative z-[1] sm:flex sm:min-h-[calc(100dvh-9rem)] flex-col justify-end sm:pb-28 lg:w-[47%]">
      <h1 class="text-4xl sm:text-8xl font-semibold tracking-normal text-white">
        Twin Function
      </h1>
      <p class="mt-6 text-lg leading-tight text-white sm:text-2xl">
        Wi-Fiも、充電も。<span class="text-gold-400">乾電池3本</span>で、どこでも復活。
      </p>
      <ProductBadge class="mt-7 w-fit text-xl" />
    </div>

    <img
      class="sm:absolute block sm:right-0 sm:top-0"
      src={assets.productWithBatteries}
      alt="Twin Function と乾電池3本"
    />

    <div class="sm:absolute bottom-8 left-5 right-5 z-[2] grid gap-6 lg:left-12 lg:right-12 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="grid max-w-[760px] grid-cols-2 gap-4 sm:grid-cols-4">
        {heroFeatures.map((item) => (
          <div class="border-r border-white/18 pr-4 last:border-r-0">
            <img class="mx-auto h-10 w-10 object-contain" src={item.icon} alt="" />
            <p class="mt-3 text-center text-sm font-medium text-white">{item.label}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-col gap-4 sm:flex-row">
        <ButtonLink class="gap-4 px-8 py-4 text-lg sm:px-14 sm:py-6 sm:text-2xl" href="#purchase">
          <img class="h-8 w-8 object-contain invert" src={assets.cartIcon} alt="" />
          購入する
        </ButtonLink>
        <ButtonLink class="px-8 py-4 text-lg sm:px-12 sm:py-6 sm:text-2xl" href="/features" variant="ghost">特徴を見る</ButtonLink>
      </div>
    </div>
  </div>
</section>
