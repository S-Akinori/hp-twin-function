---
import { navItems } from "../data/site";
---

<header class="fixed left-0 right-0 top-0 z-20 bg-ink-950/55 backdrop-blur-xl">
  <nav class="mx-auto flex h-20 w-full max-w-[1680px] items-center px-5 sm:px-8 lg:px-12">
    <a href="#top" class="flex items-center gap-4 text-xl font-semibold text-white">
      <span class="relative block h-8 w-10 rounded border border-white/65 before:absolute before:-right-2 before:-top-2 before:h-8 before:w-10 before:rounded before:border before:border-white/35"></span>
      <span>Twin Function</span>
    </a>
    <div class="ml-auto flex items-center gap-6 lg:gap-10">
      <div class="hidden items-center gap-10 text-base font-semibold text-white/88 lg:flex">
        {navItems.map((item) => <a class="transition hover:text-gold-400" href={item.href}>{item.label}</a>)}
      </div>
      <a href="#purchase" class="yellow-button px-9 py-3.5 text-base">購入する</a>
    </div>
  </nav>
</header>
