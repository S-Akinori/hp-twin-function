---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="mx-auto grid max-w-[1120px] gap-5">
  {items.map((item) => (
    <details class="group rounded-lg border border-white/10 bg-white/[0.035] p-6 shadow-insetLine">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-xl font-bold text-white">
        {item.question}
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gold-400 text-ink-950 transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-5 text-lg leading-8 text-white/[0.72]">{item.answer}</p>
    </details>
  ))}
</div>
